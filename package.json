{
  "name": "mayskiiiy-zh-vc",
  "version": "1.1.1",
  "description": "MAYSKIIIY ZH&VC music player",
  "main": "main.js",
  "author": "MAYSKIIIY ZH&VC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mayskiiiy.zhvc",
    "productName": "MAYSKIIIY ZH&VC",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "www/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAYSKIIIY ZH&VC",
      "installerIcon": "www/icon.ico",
      "uninstallerIcon": "www/icon.ico",
      "artifactName": "MAYSKIIIY-ZH-VC-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MAYSKIIIY-ZH-VC-Portable-${version}.${ext}"
    },
    "publish": null
  }
}
